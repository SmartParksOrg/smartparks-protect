# Smart Parks Protect environment. Copy to .env and edit. Every variable is read by docker compose
# and by shared/config.py. Values here are development defaults; change all secrets on a server.

# Compose
COMPOSE_PROJECT_NAME=smartparks-protect
# Optional profiles, comma separated. "chirpstack" adds a local ChirpStack stack for LoRaWAN testing.
COMPOSE_PROFILES=
ENVIRONMENT=development

# PostgreSQL (TimescaleDB image with PostGIS)
POSTGRES_USER=protect
POSTGRES_PASSWORD=protect-dev-password
POSTGRES_DB=smartparks_protect
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://protect:protect-dev-password@localhost:5432/smartparks_protect

# Redis (event bus and cache)
REDIS_PASSWORD=protect-dev-redis
REDIS_PORT=6379
REDIS_URL=redis://:protect-dev-redis@localhost:6379/0

# MinIO (raw log files, uploads, exports)
MINIO_ROOT_USER=protect
MINIO_ROOT_PASSWORD=protect-dev-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_LOG_FILES=device-log-files

# Event bus and workers
BUS_MAXLEN=100000
BUS_DEAD_MAXLEN=10000
BUS_MAX_ATTEMPTS=5
BUS_RETRY_BASE_SECONDS=5
# Messages handled concurrently per worker; messages of one device stay in order.
BUS_CONCURRENCY=8
HEARTBEAT_STALE_MINUTES=15
# Raw payloads above this size are stored in MinIO instead of the database.
PAYLOAD_INLINE_MAX_BYTES=65536

# API
API_PORT=8000
# At least 32 characters. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus
JWT_LIFETIME_SECONDS=3600
# Add http://localhost:6274 when testing with the MCP inspector.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL of the frontend, used in invitation and password reset links.
PUBLIC_URL=http://localhost:3000
# Encrypts data source credentials at rest. Losing it means re-entering every credential.
CREDENTIALS_KEY=change-me-to-another-long-random-string
INVITATION_LIFETIME_HOURS=168

# Mail (invitations, password reset). Leave empty in development: mails are logged, not sent.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# In development only these addresses receive mail, everything else is logged.
DEV_NOTIFY_EMAILS=
# Telegram notifications: one bot per installation (create it with @BotFather). Empty disables Telegram.
TELEGRAM_BOT_TOKEN=

# Rules and automation
# How often the rules service re-reads enabled rules.
RULES_RELOAD_SECONDS=10
# Interval of the worker, lag and dead-letter checks that raise system alerts.
SYSTEM_CHECK_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
# json or text
LOG_FORMAT=text

# MCP server for AI clients (architecture 27). The public URL defaults to PUBLIC_URL plus /mcp and
# is the audience of every access token; set it only when the MCP server has its own host name.
MCP_PORT=8001
MCP_PUBLIC_URL=
# Lifetimes of the OAuth artefacts: consent request, authorization code, refresh token.
OAUTH_CONSENT_LIFETIME_SECONDS=600
OAUTH_CODE_LIFETIME_SECONDS=300
OAUTH_REFRESH_TOKEN_LIFETIME_DAYS=30

# Frontend
FRONTEND_PORT=3000
# Empty means same origin (the frontend container proxies /api to the API container).
VITE_API_URL=
# Where the Vite dev server proxies /api to when you run npm run dev outside docker.
VITE_PROXY_TARGET=http://localhost:8000

# ChirpStack profile (only used with COMPOSE_PROFILES=chirpstack)
CHIRPSTACK_POSTGRES_PASSWORD=chirpstack-dev-password
CHIRPSTACK_API_SECRET=change-me-chirpstack-api-secret
CHIRPSTACK_WEB_PORT=8080
CHIRPSTACK_REST_PORT=8090
CHIRPSTACK_MQTT_PORT=1883
