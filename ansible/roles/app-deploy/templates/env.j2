# Written by ansible; edit host_vars and run --tags sync-config instead of editing this file.
COMPOSE_PROJECT_NAME=smartparks-protect
COMPOSE_PROFILES={{ compose_profiles | default('') }}
ENVIRONMENT={{ app_environment | default('production') }}

POSTGRES_USER=protect
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB=smartparks_protect
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://protect:{{ postgres_password }}@localhost:5432/smartparks_protect

REDIS_PASSWORD={{ redis_password }}
REDIS_PORT=6379
REDIS_URL=redis://:{{ redis_password }}@localhost:6379/0

MINIO_ROOT_USER={{ minio_root_user | default('protect') }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_LOG_FILES=device-log-files

BUS_MAXLEN=100000
BUS_DEAD_MAXLEN=10000
BUS_MAX_ATTEMPTS=5
BUS_RETRY_BASE_SECONDS=5
BUS_CONCURRENCY={{ bus_concurrency | default(8) }}
HEARTBEAT_STALE_MINUTES=15
PAYLOAD_INLINE_MAX_BYTES=65536
# Raw device log files: the largest upload accepted and frames decoded per transaction
LOG_FILE_MAX_BYTES=67108864
LOG_FILE_BATCH_SIZE=200

API_PORT=8000
JWT_SECRET={{ jwt_secret }}
JWT_LIFETIME_SECONDS=3600
CORS_ORIGINS={{ 'https://' + domain_name if domain_name is defined else 'http://' + ansible_host }}
PUBLIC_URL={{ 'https://' + domain_name if domain_name is defined else 'http://' + ansible_host }}
CREDENTIALS_KEY={{ credentials_key }}
INVITATION_LIFETIME_HOURS=168

MAIL_SERVER={{ mail_server | default('') }}
MAIL_PORT={{ mail_port | default(587) }}
MAIL_USERNAME={{ mail_username | default('') }}
MAIL_PASSWORD={{ mail_password | default('') }}
MAIL_FROM={{ mail_from | default('') }}
DEV_NOTIFY_EMAILS={{ dev_notify_emails | default('') }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default('') }}
RULES_RELOAD_SECONDS=10
SYSTEM_CHECK_INTERVAL_SECONDS=300
LOG_LEVEL={{ log_level | default('INFO') }}
LOG_FORMAT=json

# Backups (docs/operations/backup-and-recovery.md). The cipher passphrase and the bucket
# credentials live in the vaulted host vars and in your password manager, never only here.
BACKUP_ENABLED={{ 'true' if backup_enabled | default(false) else 'false' }}
BACKUP_REPO_TYPE=s3
BACKUP_S3_ENDPOINT={{ backup_s3_endpoint | default('') }}
BACKUP_S3_SECURE=true
BACKUP_S3_BUCKET={{ backup_s3_bucket | default('') }}
BACKUP_S3_REGION={{ backup_s3_region | default('us-east-1') }}
BACKUP_S3_KEY={{ backup_s3_key | default('') }}
BACKUP_S3_KEY_SECRET={{ backup_s3_key_secret | default('') }}
BACKUP_S3_URI_STYLE={{ backup_s3_uri_style | default('path') }}
BACKUP_CIPHER_PASS={{ backup_cipher_pass | default('') }}
BACKUP_RETENTION_FULL={{ backup_retention_full | default(4) }}
BACKUP_OBJECT_PREFIX={{ backup_object_prefix | default(inventory_hostname) }}
BACKUP_STALE_HOURS=26
RESTORE_TEST_STALE_DAYS=8
WAL_ARCHIVE_STALE_MINUTES=120

TRACE_RETENTION_ROUTINE_DAYS={{ trace_retention_routine_days | default(30) }}
TRACE_RETENTION_FAILED_DAYS={{ trace_retention_failed_days | default(180) }}
TRACE_RETENTION_COMMAND_DAYS={{ trace_retention_command_days | default(365) }}
TRACE_RETENTION_AUDIT_DAYS={{ trace_retention_audit_days | default(730) }}

OTEL_EXPORTER_OTLP_ENDPOINT={{ otel_exporter_otlp_endpoint | default('') }}
LGTM_GRAFANA_PORT=3001

FRONTEND_PORT=3000
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:8000

CHIRPSTACK_POSTGRES_PASSWORD={{ chirpstack_postgres_password | default(postgres_password) }}
CHIRPSTACK_API_SECRET={{ chirpstack_api_secret | default('unused') }}
CHIRPSTACK_WEB_PORT=8080
CHIRPSTACK_MQTT_PORT=1883
