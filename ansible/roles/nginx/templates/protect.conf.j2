# Smart Parks Protect: nginx in front of the frontend container (:3000) and the API (:8000).
limit_req_zone $binary_remote_addr zone=protect_api:10m rate=600r/m;
limit_req_zone $binary_remote_addr zone=protect_auth:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=protect_ingest:10m rate=3000r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

{% set has_cert = enable_ssl | default(false) and domain_name is defined and (ssl_cert.stat.exists | default(false)) %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name | default('_') }};
{% if has_cert %}
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain_name }};
    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
    client_max_body_size 64M;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/v1/auth/ {
        limit_req zone=protect_auth burst=10 nodelay;
        gzip off;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
    }

    location /api/v1/ingest/ {
        limit_req zone=protect_ingest burst=500 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 30s;
    }

    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        limit_req zone=protect_api burst=100 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
    }
}
