# Smart Parks Protect: nginx in front of the frontend container (:3000) and the API (:8000).
limit_req_zone $binary_remote_addr zone=protect_api:10m rate=600r/m;
limit_req_zone $binary_remote_addr zone=protect_auth:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=protect_ingest:10m rate=3000r/m;
limit_req_zone $binary_remote_addr zone=protect_mcp:10m rate=300r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

{% set has_cert = enable_ssl | default(false) and domain_name is defined and (ssl_cert.stat.exists | default(false)) %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name | default('_') }};
{% if has_cert %}
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain_name }};
    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
    client_max_body_size 64M;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # While the stack restarts (the deploy raises the flag, D329) or an upstream is down, a
    # page load gets a small page that retries by itself and an API call a JSON message, not
    # nginx's bare 502. The flag file is written and removed by the app-deploy role.
    if (-f /var/www/protect/updating) {
        return 503;
    }
    error_page 502 503 504 /unavailable.html;
    location = /unavailable.html {
        root /var/www/protect;
        internal;
        add_header Retry-After 10 always;
        add_header Cache-Control no-store always;
    }
    location @api_unavailable {
        default_type application/json;
        add_header Retry-After 10 always;
        add_header Cache-Control no-store always;
        return 503 '{"detail": "Protect is being updated or restarting. Try again in a moment.", "unavailable": true}';
    }

    location /api/v1/auth/ {
        limit_req zone=protect_auth burst=10 nodelay;
        gzip off;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_unavailable;
    }

    location /api/v1/ingest/ {
        limit_req zone=protect_ingest burst=500 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_unavailable;
    }

    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        limit_req zone=protect_api burst=100 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_read_timeout 120s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_unavailable;
    }

    # AI clients (architecture 27): OAuth discovery on the API, the MCP server on :8001.
    location = /.well-known/oauth-authorization-server {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
    }

    location /.well-known/oauth-protected-resource {
        proxy_pass http://127.0.0.1:8001;
        include /etc/nginx/proxy_params;
    }

    location /mcp {
        limit_req zone=protect_mcp burst=50 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        include /etc/nginx/proxy_params;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_unavailable;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
        proxy_intercept_errors on;
    }
}
