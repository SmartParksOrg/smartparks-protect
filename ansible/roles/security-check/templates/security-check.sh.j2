#!/bin/bash
# One definition of a secure Smart Parks Protect server, run at the end of every deploy and daily
# by scripts/security-status.sh. Exit 1 on a critical finding. Must run as root.
set -uo pipefail
passed=0; failed=0; warned=0
ok()   { echo "PASS  $1"; passed=$((passed+1)); }
fail() { echo "FAIL  $1"; failed=$((failed+1)); }
warn() { echo "WARN  $1"; warned=$((warned+1)); }

ufw status | grep -q "Status: active" && ok "firewall active" || fail "firewall inactive"
for port in 5432 6379 9000 9001 8000 3000 8080 8090 1883; do
  if ss -ltn "( sport = :$port )" | grep -qE "(0\.0\.0\.0|\[::\]|\*):$port"; then
    fail "port $port listens on every interface"
  else
    ok "port $port not public"
  fi
done
# Not `sshd -T | grep -q`: under pipefail, grep closing the pipe early fails the pipeline.
grep -q "passwordauthentication no" <<< "$(sshd -T 2>/dev/null)" && ok "ssh password login off" || fail "ssh password login on"
systemctl is-active --quiet fail2ban && ok "fail2ban running" || fail "fail2ban not running"
grep -q '"${distro_id}:${distro_codename}-security"' /etc/apt/apt.conf.d/52protect-unattended 2>/dev/null && ok "security updates configured" || fail "unattended upgrades not configured"
[ -f /var/run/reboot-required ] && warn "reboot pending for a security update" || ok "no reboot pending"
ENV="{{ app_directory }}/.env"
if [ -f "$ENV" ]; then
  [ "$(stat -c %a "$ENV")" = "600" ] && ok ".env mode 600" || fail ".env is readable by others"
  grep -qE '^(JWT_SECRET|CREDENTIALS_KEY|POSTGRES_PASSWORD|REDIS_PASSWORD|MINIO_ROOT_PASSWORD)=.*CHANGE_ME' "$ENV" && fail "placeholder secrets in .env" || ok "no placeholder secrets"
else
  fail ".env missing"
fi
cd "{{ app_directory }}" 2>/dev/null && {
  down=$(docker compose ps --format '{{ "{{" }}.Name{{ "}}" }} {{ "{{" }}.State{{ "}}" }}' | grep -v migrate | grep -vc running || true)
  [ "$down" = "0" ] && ok "every container running" || fail "$down container(s) not running"
}
echo "passed=$passed failed=$failed warnings=$warned"
[ "$failed" -eq 0 ]
