#!/bin/sh
# Strip assistant co-author and generated-by lines from commit messages (decision D28).
# Install once per clone: git config core.hooksPath .githooks

MSG_FILE="$1"

sed -i.bak '/^Co-Authored-By: Claude.*/d' "$MSG_FILE"
sed -i.bak '/^Co-Authored-By: Codex.*/d' "$MSG_FILE"
sed -i.bak '/Generated with \[Claude Code\]/d' "$MSG_FILE"

# Remove trailing blank lines
sed -i.bak -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$MSG_FILE"

rm -f "${MSG_FILE}.bak"
